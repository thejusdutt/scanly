<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Scanned documents are private and stay on-device: exclude from cloud backup. -->
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
